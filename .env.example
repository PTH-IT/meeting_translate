# AI Service Configuration
AI_SERVICE_URL=http://localhost:8001

# Model cache directory
MODEL_CACHE_DIR=./models

# Mock mode toggles (set to false to use real models)
MOCK_VAD=true
MOCK_TRANSCRIPTION=true
MOCK_DIARIZATION=true
MOCK_TRANSLATION=false

# Model settings
WHISPER_MODEL=large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
TRANSLATION_MODEL=google/gemma-2b-it

# Audio settings
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_DURATION=5
